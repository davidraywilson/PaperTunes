<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <application>
        <!-- Remove the standard MainActivity -->
        <activity
            android:name="moe.rukamori.archivetune.MainActivity"
            tools:node="remove" />

        <!-- Set EinkActivity as the launcher -->
        <activity
            android:name="moe.rukamori.archivetune.eink.EinkActivity"
            android:exported="true"
            android:theme="@style/Theme.ArchiveTune">
        </activity>
    </application>
</manifest>
